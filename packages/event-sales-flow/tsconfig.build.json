{
    // Сборка ДЕКЛАРАЦИЙ пакета: `.d.ts` для потребителей, без JS (рантайм
    // собирают сами приложения — transpilePackages).
    //
    // ЗАЧЕМ. Зеркальное ядро писано под БЭКОВУЮ строгость (без
    // noUncheckedIndexedAccess/isolatedModules), и правка зеркал запрещена
    // правилом анти-дрейфа. Приложения компилируются строже: включи они
    // исходники пакета в свою программу tsc — получили бы ошибки в файлах,
    // которые чинить нельзя. Декларации снимают вопрос: типы РОЖДЕНЫ из
    // настоящего кода этой программой (расходиться не с чем), а строгость
    // потребителя к ним не применяется.
    //
    // Эта же программа проверяет ядро (эмит без ошибок невозможен), поэтому
    // `typecheck` пакета гоняет её вместо отдельного `--noEmit`.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "./build",
        // Адаптеры тянут живые @workspace/bitrix|pbx с process.env — им
        // нужны node-типы (ядро остаётся изоморфным, см. tsconfig.json).
        "types": ["vitest/globals", "node"],
        "allowJs": true
    },
    "include": ["src/**/*"],
    "exclude": ["src/**/__tests__/**", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
