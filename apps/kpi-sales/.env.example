# Ключ legacy online API (Laravel) — нужен proxy-роутам /api/proxy/* до ухода на nest-kpi-report-sales-api
ONLINE_API_KEY=''

# Приложение открыто внутри Bitrix-фрейма (prod) или standalone dev
IN_BITRIX=false
NEXT_PUBLIC_IN_BITRIX=false

LOG_FILE_PATH='/app/logs/server.log'

NEXT_PUBLIC_WS_HOST='https://back.april-app.ru'
NEXT_PUBLIC_APP_URL='http://localhost:3000'
BACK_API_URL='https://back.april-app.ru'

# База нового бэка kpi-report-sales (orval-пакет @workspace/nest-kpi-report-sales-api).
# Пусто = dev-дефолт http://localhost:3000/. Prod: https://api.kpi-sales.april-app.ru/
NEXT_PUBLIC_KPI_SALES_API_URL=''
