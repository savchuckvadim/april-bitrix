# ─── Обязательные: next.config.ts падает на сборке, если пусто ───────────────
# (проверка формальная — PDF_PREVIEW_URL и PORT в коде приложения не читаются)
ONLINE_API_KEY=
IN_BITRIX=true
LOG_FILE_PATH='/app/logs/server.log'
PDF_PREVIEW_URL=http://localhost:5000/offer/preview?readonly=true
PORT=3000

# ─── База бэка event-sales (back/apps/event-sales) ───────────────────────────
# Единственный настраиваемый бэкенд-URL приложения.
# Читается в app/components/api-provider.tsx -> configureBaseURL,
# и им же задаётся WS-хост (socket.io живёт в том же приложении бэка;
# modules/app/model/store.ts -> resolveWsHost) — события *-flow:done.
# Пусто = дев-дефолт пакета @workspace/nest-event-sales-api (http://localhost:3005/)
NEXT_PUBLIC_EVENT_SALES_API_URL='https://api.event-sales.april-app.ru/'

# Остальные бэки настройки не требуют — адреса зашиты в пакетах:
#   @workspace/nest-api  -> https://back.april-app.ru/
#   @workspace/api       -> https://event.april-app.ru/api/v1/event/ и др.,
#                           авторизация только через ONLINE_API_KEY (X-API-KEY)

# ─── Необязательное ──────────────────────────────────────────────────────────
# Префикс, под которым приложение живёт на домене (прод: /sales, см.
# deploy/nginx/next.april-app.ru.conf). Пусто = дефолт из next.config.ts:
# в dev префикса нет, в прод-сборке '/sales'.
# NEXT_PUBLIC_BASE_PATH=

# ─── Бизнес-метрики (Prometheus) ─────────────────────────────────────────────
# Браузер шлёт замеры пачкой на /api/metrics/report, процесс отдаёт их
# Prometheus на /api/metrics (реестр — app/lib/metrics/registry.ts).
#
# ОТДАЧА МЕТРИК ЗАКРЫТА ОБЩИМ СЕКРЕТОМ И НЕ РАБОТАЕТ БЕЗ НЕГО. Пока эта
# переменная не задана, GET /api/metrics отвечает 404 всем, включая
# Prometheus. Так сделано намеренно: в теле ответа — разрез по доменам ВСЕХ
# клиентских порталов, и забытая переменная обязана ломать сбор метрик, а не
# открывать список клиентов наружу.
#
# Тот же токен прописывается цели Prometheus (bearer_token / bearer_token_file
# в back/infra/prometheus/prometheus.yml). Значение — любая длинная случайная
# строка, например `openssl rand -hex 32`. Это НЕ NEXT_PUBLIC_: секрет
# серверный и в бандл попасть не должен.
# METRICS_SCRAPE_TOKEN=
#
# Выключить приём БЕЗ релиза и пересборки — серверная переменная, читается в
# рантайме, достаточно перезапустить контейнер:
# METRICS_DISABLED=1
#
# Выключить сбор в браузере — переменная СБОРКИ (NEXT_PUBLIC_* инлайнится в
# бандл, см. предупреждение про прод ниже):
# NEXT_PUBLIC_METRICS_DISABLED=1

# ВАЖНО про прод (схема GHCR, docker-compose.prod.yml):
#   ONLINE_API_KEY / IN_BITRIX / LOG_FILE_PATH / NEXT_PUBLIC_* инлайнятся
#   в бандл НА СБОРКЕ (next.config `env` + build-args в
#   .github/workflows/deploy-front-prod.yml). Значения из этого файла в
#   runtime их уже не переопределяют — правь APP_CFG в workflow.
#   Непустым этот файл на сервере быть обязан: деплой-скрипт пропускает
#   приложение с пустым apps/<app>/.env.
