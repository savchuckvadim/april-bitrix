{
    // Корень монорепы намеренно пустой по составу: типы проверяются
    // по пакетам, у каждого apps/* и packages/* свой tsconfig со своими
    // jsx, baseUrl и paths. Без "files"/"include" корневой tsc забирал бы
    // весь `**/*` монорепы без этих настроек и выдавал десятки тысяч
    // ложных ошибок на ровном месте.
    //
    // Настоящая проверка типов:
    //   pnpm typecheck            — turbo прогоняет tsc в каждом пакете;
    //   npx tsc --noEmit          — внутри конкретного apps/* | packages/*.
    //
    // "extends" оставлен как база для редактора, если у корня когда-нибудь
    // появятся собственные файлы; на состав это не влияет.
    "extends": "@workspace/typescript-config/base.json",
    "files": [],
    "include": []
}
