# Образец окружения админки. Реальные значения — в apps/admin/.env на сервере
# (его подхватывает env_file в docker-compose.prod.yml); в образ GHCR .env
# не зашивается.
#
# ВАЖНО: все NEXT_PUBLIC_* инлайнятся в клиентский бандл НА СБОРКЕ, поэтому
# для прода они задаются в APP_CFG workflow-а деплоя
# (.github/workflows/deploy-front-prod.yml), а не только здесь. Пустое
# значение молча превращается в дев-дефолт localhost.

# Обязательная (next.config.ts валидирует при старте)
NEXT_PUBLIC_APP_URL=https://back.april-app.ru

IN_BITRIX=true
NEXT_PUBLIC_IN_BITRIX=true
NEXT_PUBLIC_WS_HOST=https://back.april-app.ru
LOG_FILE_PATH=./logs/app.log
YANDEX_ID=105777667

# Ключ к Laravel-API online. Секрет: в деплое приходит из secrets.ONLINE_API_KEY
ONLINE_API_KEY=

# Домены бэкендов админки
NEXT_PUBLIC_ADMIN_API_URL=https://api.admin.april-app.ru/
NEXT_PUBLIC_PBX_INSTALL_API_URL=https://api.install.april-app.ru/
NEXT_PUBLIC_KONSTRUCTOR_API_URL=https://api.konstructor.april-app.ru/

# Адрес сайта bitrix: из него собираются ссылки на КП на следующий год,
# которые отправляют клиенту (раздел «КП на год»). Не адрес бэкенда, а адрес
# сайта, который откроет клиент.
# Пусто = прод-дефолт https://bitrix.april-app.ru
NEXT_PUBLIC_BITRIX_APP_URL=https://bitrix.april-app.ru

# Публичный адрес Grafana (наблюдение). Задан — на странице портала появится
# ссылка «Нагрузка на Битрикс» на дашборд april-bitrix-load с фильтром по
# домену. Пусто — ссылки нет. Для прода — в APP_CFG workflow-а деплоя.
NEXT_PUBLIC_GRAFANA_URL=
