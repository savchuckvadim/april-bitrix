{
    "compilerOptions": {
        "outDir": "./build/",
        "noImplicitAny": true,
        "module": "ESNext",
        // ES2020: пакет и так собирается сборщиками приложений, а на es5
        // не типизируются ни спред Set (bx-user.service), ни .d.ts
        // зависимостей (b24jssdk) — прецедент: packages/api/tsconfig.json
        "target": "ES2020",
        "lib": ["DOM", "DOM.Iterable", "ES2020"],
        "jsx": "react-jsx",
        "allowJs": true,
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        // как в @workspace/typescript-config/base.json: чужие .d.ts не наша забота
        "skipLibCheck": true,
        "esModuleInterop": true,
        "baseUrl": ".",
        "resolveJsonModule": true,
        "paths": {
            "@bitrix/*": ["./src/*"] // Это указывает путь к алиасу
        }
    },
    "ts-node": {
        "compilerOptions": {
            "module": "CommonJS"
        }
    },
    "include": ["src/**/*", "src/global.d.ts"]
}
