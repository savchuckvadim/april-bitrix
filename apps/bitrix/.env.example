# Образец окружения приложения bitrix. Реальные значения — в apps/bitrix/.env
# на сервере (его подхватывает env_file в docker-compose.prod.yml); в образ
# GHCR .env не зашивается.

# Обязательная (next.config.ts валидирует при старте)
NEXT_PUBLIC_APP_URL=https://bitrix.april-app.ru

IN_BITRIX=true
NEXT_PUBLIC_IN_BITRIX=true
NEXT_PUBLIC_WS_HOST=https://back.april-app.ru
LOG_FILE_PATH=./logs/app.log
YANDEX_ID=105777667

# Ключ к Laravel-API online. Секрет: в деплое приходит из secrets.ONLINE_API_KEY
ONLINE_API_KEY=

# База pbx-API (back/apps/pbx) для серверных запросов страницы предложения
# `/renewal/<token>`: по токену оттуда приходят состав услуг и цены клиента.
# Переменная БЕЗ NEXT_PUBLIC_ намеренно — запрос идёт только на сервере,
# адрес бэкенда в браузер не отдаём.
# Пусто = прод-дефолт https://api.pbx.april-app.ru
# Локальный бэк: http://localhost:3009
PBX_API_URL=
