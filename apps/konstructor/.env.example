# Обязательные (next.config.ts валидирует при старте)
IN_BITRIX=false
# false в dev (вне фрейма Bitrix); прод-сборка ставит true — иначе NonAuthScreen
NEXT_PUBLIC_IN_BITRIX=false
LOG_FILE_PATH=./logs/app.log
PORT=3000

# База konstructor-API (back/apps/konstructor).
# Пусто = дев-дефолт пакета @workspace/nest-konstructor-api (http://localhost:3007/).
# Прод (реальные данные): https://api.konstructor.april-app.ru/
NEXT_PUBLIC_KONSTRUCTOR_API_URL=https://api.konstructor.april-app.ru/
